PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coo_pa_manager
JWT_SECRET=replace_with_strong_secret

# --- Email (use Resend on DigitalOcean — SMTP ports are blocked) ---
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx

# Must be an address on a domain verified in Resend (SPF + DKIM).
# Prefer a subdomain mailbox: notifications@mail.yourdomain.com
EMAIL_FROM="Meeting Manager <notifications@mail.yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com

# Links in emails MUST match your brand domain when possible (spam filters check this).
APP_URL=https://civilmantra-task-manager.vercel.app

EMAIL_APP_NAME=Civil Mantra Meeting Manager
EMAIL_APP_TAGLINE=Scheduled by the Civil Mantra Management Team
EMAIL_COMPANY_ADDRESS=Civil Mantra · Internal notifications only

# --- SMTP (used by POST /api/meetings/send-upcoming-emails, and when EMAIL_PROVIDER=smtp) ---
# Note: DigitalOcean blocks outbound SMTP ports 25/465/587 by default.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Meeting Manager <your-email@gmail.com>"
